From 98f0aa3ad7d7fd921d7e710a50f6133fb188190e Mon Sep 17 00:00:00 2001
From: Herwig Hochleitner <herwig@bendlas.net>
Date: Wed, 16 Sep 2026 16:22:02 +0200
Subject: [PATCH 3/4] nixos/headplane: [breaking] also dissolve nullOr
 submodules

---
 .../manual/release-notes/rl-2611.section.md   |  17 +
 .../modules/services/networking/headplane.nix | 514 +++++++++---------
 2 files changed, 276 insertions(+), 255 deletions(-)

diff --git a/nixos/doc/manual/release-notes/rl-2611.section.md b/nixos/doc/manual/release-notes/rl-2611.section.md
index 0d70a142390ca..5b29fb3a32512 100644
--- a/nixos/doc/manual/release-notes/rl-2611.section.md
+++ b/nixos/doc/manual/release-notes/rl-2611.section.md
@@ -138,6 +138,23 @@
 
 <!-- To avoid merge conflicts, consider adding your item at an arbitrary place in the list instead. -->
 
+- The `services.headplane.settings` option has been restructured so
+  that it accepts freeform types. For that, intermediate `submodule`
+  have been removed, along with any `nullOr` wrappers. All leaf option
+  definitions are unchanged in name, type, default, and description.
+
+  This is a breaking change for configurations that relied on the
+  removed nullability: `settings.server.proxy_auth`,
+  `settings.integration.agent` and `settings.server.oidc` are now
+  always-present groups (instead of `null` when unset) and freeform
+  keys are now accepted beneath them. The generated `config.yaml` is
+  unchanged for configurations that left those groups at their
+  defaults or set `enabled = true`; a disabled
+  `proxy_auth`/`agent`/`oidc` is still omitted from the output.
+
+  Existing configurations that set `settings.oidc` without `enable` must
+  now also set `settings.oidc.enable = true` to enable OIDC.
+
 - Artalk has been updated to 2.10.0. Its default configuration and data
   directory discovery changed; see the [upstream migration
   guide](https://artalk.js.org/en/guide/releases/v2.10.0.html) when invoking
diff --git a/nixos/modules/services/networking/headplane.nix b/nixos/modules/services/networking/headplane.nix
index 418abb78980f8..a17feb328d73b 100644
--- a/nixos/modules/services/networking/headplane.nix
+++ b/nixos/modules/services/networking/headplane.nix
@@ -27,7 +27,18 @@ let
   agentSettings = cfg.settings.integration.agent;
   settings = cfg.settings // {
